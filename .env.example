# Copy to .env. Never commit the real file.
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
MOD_REVIEW_CHANNEL_ID=
SUBMISSION_CHANNEL_ID=
# Comma-separated channel IDs to monitor. Threads inherit an allowed parent.
MONITORED_CHANNEL_IDS=
# observe | review | hold. Hold is post-publication delete and mod-approved repost.
MODERATION_MODE=observe
# local | jev | laya_studio | zippy_decisions | systemone_local. Hosted providers send redacted text.
CLASSIFIER_PROVIDER=local
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
LAYA_API_KEY=
LAYA_MODEL=typed-decisions
# Optional JSON file for ordered routes. Keep real channel IDs in a gitignored file.
CLASSIFIER_ROUTES_PATH=
# Optional comma-separated role IDs. Review still needs Manage Messages; configuration is file-managed.
MOD_VIEW_ROLE_IDS=
MOD_REVIEW_ROLE_IDS=
MOD_CONFIG_ROLE_IDS=
# Optional loopback-only development sidecar. Never expose it to the public network.
ZIPPY_DECISIONS_URL=http://127.0.0.1:8766/v1/systemone
SYSTEMONE_LOCAL_URL=http://127.0.0.1:8767/v1/systemone
CASE_DIR=./data/cases
