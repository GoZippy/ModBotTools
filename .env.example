# Copy to .env. Never commit the real file.
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
MOD_REVIEW_CHANNEL_ID=
SUBMISSION_CHANNEL_ID=
# Comma-separated channel IDs to monitor. Threads inherit an allowed parent.
MONITORED_CHANNEL_IDS=
# observe | review | hold. Hold is post-publication delete and mod-approved repost.
MODERATION_MODE=observe
# local | jev | zippy_decisions. Jev sends redacted text to TypeSafe.
CLASSIFIER_PROVIDER=local
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
# Optional loopback-only development sidecar. Never expose it to the public network.
ZIPPY_DECISIONS_URL=http://127.0.0.1:8766/v1/systemone
CASE_DIR=./data/cases
