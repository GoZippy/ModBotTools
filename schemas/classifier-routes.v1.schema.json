{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/GoZippy/ModBotTools/schemas/classifier-routes.v1.schema.json",
  "title": "ModBot classifier routes v1",
  "type": "object",
  "required": ["schema_version", "routes"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "modbot.routes.v1" },
    "routes": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "required": ["id", "trigger", "channelIds", "surfaces", "provider", "mode"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{1,39}$" },
          "trigger": { "enum": ["message_create", "message_update", "submission"] },
          "channelIds": { "type": "array", "items": { "type": "string", "pattern": "^[0-9]{1,20}$" }, "uniqueItems": true },
          "surfaces": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["text", "thread", "voice_text", "submission", "voice_transcript"] } },
          "provider": { "enum": ["local", "jev", "laya_studio", "zippy_decisions", "systemone_local"] },
          "mode": { "enum": ["observe", "review", "hold"] },
          "model": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,64}$" }
        },
        "allOf": [
          { "if": { "properties": { "trigger": { "const": "submission" } }, "required": ["trigger"] }, "then": { "properties": { "mode": { "const": "review" }, "surfaces": { "const": ["submission"] } } }, "else": { "properties": { "surfaces": { "items": { "enum": ["text", "thread", "voice_text", "voice_transcript"] } } } } },
          { "if": { "properties": { "provider": { "enum": ["zippy_decisions", "systemone_local"] } }, "required": ["provider"] }, "then": { "properties": { "mode": { "enum": ["observe", "review"] } } } },
          { "if": { "required": ["model"] }, "then": { "properties": { "provider": { "enum": ["jev", "laya_studio", "systemone_local"] } } } }
        ]
      }
    }
  }
}
