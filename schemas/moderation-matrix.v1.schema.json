{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:modbot:moderation-matrix:v1",
  "title": "ModBot moderation matrix v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "name", "questions", "thresholds", "actions"],
  "properties": {
    "schema_version": { "const": "modbot.matrix.v1" },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "questions": {
      "type": "object", "minProperties": 1,
      "additionalProperties": {
        "type": "object", "required": ["type", "instructions"],
        "properties": {
          "type": { "enum": ["noul", "choice", "score"] },
          "instructions": { "type": "string", "minLength": 1 },
          "criteria": { "oneOf": [ { "type": "array", "items": { "type": "string" } }, { "type": "object", "additionalProperties": { "type": "string" } } ] }
        }
      }
    },
    "thresholds": {
      "type": "object", "additionalProperties": false,
      "required": ["flag_signal", "flag_severity_score", "flag_severity_confidence", "hold_spam", "hold_scam", "hold_max_characters"],
      "properties": {
        "flag_signal": { "type": "number", "minimum": 0, "maximum": 1 },
        "flag_severity_score": { "type": "number", "minimum": 0, "maximum": 3 },
        "flag_severity_confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "hold_spam": { "type": "number", "minimum": 0, "maximum": 1 },
        "hold_scam": { "type": "number", "minimum": 0, "maximum": 1 },
        "hold_max_characters": { "type": "integer", "minimum": 1, "maximum": 1800 }
      }
    },
    "actions": { "type": "object", "required": ["allow", "flag", "hold"], "properties": { "allow": { "type": "string" }, "flag": { "type": "string" }, "hold": { "type": "string" } } }
  }
}
