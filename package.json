{
  "name": "mod-bot-tools",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.17.0" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "test": "npm run build && node --test dist/*.test.js dist/**/*.test.js",
    "demo": "npm run build && node dist/demo.js",
    "evaluate": "npm run build && node --env-file-if-exists=.env dist/evaluate.js fixtures/eval.sample.jsonl"
  },
  "dependencies": { "discord.js": "14.27.0" },
  "devDependencies": { "@types/node": "24.9.1", "typescript": "5.9.3" },
  "license": "MIT"
}
